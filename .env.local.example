# SERVER-ONLY — never use NEXT_PUBLIC_ for these
# Next.js rewrite target for /api/v1/* (see next.config.js)
API_BASE_URL=http://localhost:8000

# Served to the login page via GET /api/config only (not inlined in the client bundle)
GOOGLE_CLIENT_ID=

# Never put these in the frontend:
# RAZORPAY_KEY_SECRET
# RAZORPAY_WEBHOOK_SECRET
# DATABASE_URL
# JWT_SECRET_KEY
# GOOGLE_CLIENT_SECRET
